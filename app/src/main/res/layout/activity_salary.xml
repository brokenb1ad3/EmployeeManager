<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BẢNG LƯƠNG NHÂN VIÊN"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp" />

    <EditText
        android:id="@+id/edtThang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tháng (1-12)"
        android:inputType="number" />

    <EditText
        android:id="@+id/edtNam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập năm"
        android:inputType="number" />

    <Button
        android:id="@+id/btnTinhLuong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tính lương tháng" />

    <ListView
        android:id="@+id/lvBangLuong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="10dp" />

</LinearLayout>
